{
	"schemaVersion": 1,
	"pluginId": "com.example.hostile-ui",
	"version": "1.0.0",
	"displayName": "Reference Hostile UI Fixture",
	"description": "Exercises the host-controlled iframe sandbox and contribution discovery contract.",
	"engine": {
		"runtime": "bun",
		"hostApi": ">=1.0 <2",
		"rpc": "narrafork.rpc/1",
		"features": [],
		"runner": "local-process"
	},
	"ui": {
		"entry": "ui/hostile.iife.js",
		"format": "iife",
		"style": "ui/hostile.css",
		"shell": "host-controlled"
	},
	"activationEvents": ["onView:hostile-panel", "onView:quiet-panel"],
	"contributes": {
		"providers": [],
		"tools": [],
		"commands": [],
		"events": [],
		"views": [
			{
				"id": "hostile-panel",
				"title": "Hostile sandbox probe",
				"entry": "ui/hostile.iife.js",
				"style": "ui/hostile.css",
				"surfaces": ["workspace", "settings"],
				"scope": "global",
				"instance": "multiple",
				"defaultPosition": "side"
			},
			{
				"id": "quiet-panel",
				"title": "Quiet reference panel",
				"entry": "ui/quiet.iife.js",
				"style": "ui/quiet.css",
				"surfaces": ["workspace"],
				"scope": "global",
				"instance": "multiple",
				"defaultPosition": "bottom"
			}
		]
	},
	"permissions": {
		"host": ["ui.panel"],
		"network": { "mode": "none", "allow": [] },
		"filesystem": { "package": "readOnly", "pluginData": "none", "workspace": "none" },
		"process": { "spawn": "none" }
	},
	"secrets": [],
	"dependencies": { "plugins": {}, "runtime": {} }
}
