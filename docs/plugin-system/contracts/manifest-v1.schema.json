								"const": "none"
							}
						},
						"required": ["spawn"]
					},
					"then": {
						"properties": {
							"executables": {
								"maxItems": 0
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"spawn": {
								"const": "allowlist"
							}
						},
						"required": ["spawn"]
					},
					"then": {
						"required": ["executables"],
						"properties": {
							"executables": {
								"minItems": 1
							}
						}
					}
				}
			]
		},
		"permissions": {
			"type": "object",
			"additionalProperties": false,
			"required": ["network", "filesystem", "process"],
			"properties": {
