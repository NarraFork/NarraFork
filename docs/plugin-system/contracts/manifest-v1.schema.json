		},
		"secret": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "label", "scope", "usage", "inject"],
			"properties": {
				"id": {
					"$ref": "#/$defs/contributionId"
				},
				"label": {
					"allOf": [
						{
							"$ref": "#/$defs/controlFreeText"
						},
						{
							"maxLength": 200
						}
					]
				},
				"required": {
					"type": "boolean",
					"default": false
				},
				"scope": {
					"type": "array",
