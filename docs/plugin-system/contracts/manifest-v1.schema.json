					}
				},
				"usage": {
					"enum": ["outbound-network", "provider", "command", "other"]
				},
				"inject": {
					"enum": ["ephemeral-reference", "rpc-opaque-reference"]
				}
			}
		},
		"dependencies": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"plugins": {
					"type": "object",
					"propertyNames": {
						"$ref": "#/$defs/pluginId"
					},
					"additionalProperties": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"default": {}
				},
				"runtime": {
					"type": "object",
					"propertyNames": {
						"type": "string",
						"minLength": 1,
						"maxLength": 64
					},
					"additionalProperties": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"default": {}
				}
			}
		},
		"activationEvents": {
			"type": "array",
			"maxItems": 100,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 256,
				"pattern": "^(?:onStartup|(?:onCommand|onView|onProvider|onTool|onEvent|onSchedule):.+)$"
			}
		}
	},
	"$comment": "Cross-item uniqueness and reference integrity (duplicate contribution IDs, view.commandId, activation event targets), plus exact URL parsing, remain canonical Zod superRefine checks in server/lib/plugins/manifest.ts."
