{
	"$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.worktrees",
			"!**/server/generated",
			"!**/frontend/routeTree.gen.ts",
			"!**/drizzle",
			"!**/examples/plugins/cline-external/server/index.js",
			"!**/examples/plugins/cline-external/ui/*.iife.js"
		]
	}
}
