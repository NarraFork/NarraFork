	"scripts": {
		"approve": "bun server/scripts/approve-all.ts",
		"build": "rm -f server/generated/embedded-frontend.ts && bunx vite build --config frontend/vite.config.ts",
		"build:cross": "bun scripts/build-cross-platform.ts",
		"build:update-server": "bun scripts/build-update-server.ts",
		"build:launcher": "bun scripts/build-launcher.ts",
		"build:launcher:linux-x64": "bun scripts/build-launcher.ts --platform=linux-x64",
		"build:linux": "bun scripts/build-cross-platform.ts --platform=linux",
		"build:linux-arm64": "bun scripts/build-cross-platform.ts --platform=linux-arm64",
		"build:linux-x64": "bun scripts/build-cross-platform.ts --platform=linux-x64",
		"build:linux-x64-baseline": "bun scripts/build-cross-platform.ts --platform=linux-x64-baseline",
		"build:macos": "bun scripts/build-cross-platform.ts --platform=darwin",
		"build:macos-arm64": "bun scripts/build-cross-platform.ts --platform=darwin-arm64",
		"build:macos-x64": "bun scripts/build-cross-platform.ts --platform=darwin-x64",
		"build:windows": "bun scripts/build-cross-platform.ts --platform=windows",
		"build:go": "bun scripts/build-go-backend.ts",
		"build:go:linux-x64": "bun scripts/build-go-backend.ts --platform=linux-x64",
		"build:go:linux-arm64": "bun scripts/build-go-backend.ts --platform=linux-arm64",
		"build:go:darwin-arm64": "bun scripts/build-go-backend.ts --platform=darwin-arm64",
		"build:go:windows-x64": "bun scripts/build-go-backend.ts --platform=win-x64",
		"check": "bunx @biomejs/biome check .",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bun server/db/migrate.ts",
		"dev": "bun run db:migrate; PORT=7779 bun run --hot server/index.ts",
		"dev:all": "bun server/dev-all.ts",
		"dev:cold": "bun server/dev-all.ts --cold",
		"dev:go": "bun server/dev-all.ts --backend=go",
		"dev:go:isolated": "bun scripts/dev-go-isolated.ts",
		"dev:ts": "bun server/dev-all.ts --backend=ts",
		"dev:frontend": "bunx vite --config frontend/vite.config.ts",
		"format": "bunx @biomejs/biome check --write .",
		"start": "NODE_ENV=production bun run db:migrate && NODE_ENV=production bun server/index.ts",
		"start:dev": "NODE_ENV=production bun run db:migrate && (NODE_ENV=production bun server/index.ts &) && VITE_PORT=41221 BACKEND_PORT=7778 bunx vite --config frontend/vite.config.ts --mode production",
		"test": "bun test",
		"test:go": "bun scripts/go-task.ts test",
		"release:go:beta": "bun scripts/release-go-beta.ts",
		"rollback:go:drill": "bun scripts/go-rollback-drill.ts",
		"typecheck": "tsgo --noEmit",
		"test:watch": "bun test --watch"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"tree-sitter-bash"
	]
}
