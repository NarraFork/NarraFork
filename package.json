{
	"name": "narrafork",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bun run db:migrate; PORT=7779 bun run --hot server/index.ts",
		"dev:frontend": "bunx vite --config frontend/vite.config.ts",
		"dev:all": "bun run db:migrate; PORT=7779 bun run --hot server/index.ts & bunx vite --config frontend/vite.config.ts & wait",
		"dev:cold": "bun run db:migrate; PORT=7779 bun run server/index.ts & bunx vite --config frontend/vite.config.ts & wait",
		"build": "rm -f server/generated/embedded-frontend.ts && bunx vite build --config frontend/vite.config.ts",
		"build:compile": "bun scripts/build-embedded.ts",
		"build:cross": "bun scripts/build-cross-platform.ts",
		"build:macos": "bun scripts/build-cross-platform.ts --platform=darwin",
		"build:macos-arm64": "bun scripts/build-cross-platform.ts --platform=darwin-arm64",
		"build:macos-x64": "bun scripts/build-cross-platform.ts --platform=darwin-x64",
		"build:linux": "bun scripts/build-cross-platform.ts --platform=linux",
		"build:linux-x64": "bun scripts/build-cross-platform.ts --platform=linux-x64",
		"build:linux-arm64": "bun scripts/build-cross-platform.ts --platform=linux-arm64",
		"build:windows": "bun scripts/build-cross-platform.ts --platform=windows",
		"start": "NODE_ENV=production bun run db:migrate && NODE_ENV=production bun server/index.ts",
		"start:dev": "NODE_ENV=production bun run db:migrate && (NODE_ENV=production bun server/index.ts &) && VITE_PORT=41221 BACKEND_PORT=7778 bunx vite --config frontend/vite.config.ts",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bun server/db/migrate.ts",
		"check": "bunx @biomejs/biome check .",
		"format": "bunx @biomejs/biome check --write .",
		"approve": "bun server/scripts/approve-all.ts",
		"test": "bun test",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@dagrejs/dagre": "^2.0.4",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mantine/core": "^7.17.0",
		"@mantine/hooks": "^7.17.0",
		"@mantine/notifications": "^7.17.8",
		"@modelcontextprotocol/sdk": "^1.26.0",
		"@tabler/icons-react": "^3.36.1",
		"@tanstack/react-query": "^5.75.0",
		"@tanstack/react-router": "^1.120.0",
		"@xterm/addon-fit": "0.10.0",
		"@xterm/addon-serialize": "0.13.0",
		"@xterm/headless": "5.5.0",
		"@xterm/xterm": "5.5.0",
		"@xyflow/react": "^12.10.0",
		"bun-pty": "^0.4.8",
		"diff": "^8.0.3",
		"drizzle-orm": "^0.44.0",
		"gray-matter": "^4.0.3",
		"hono": "^4.7.0",
		"i18next": "^25.8.6",
		"i18next-browser-languagedetector": "^8.2.1",
		"iconv-lite": "^0.7.2",
		"jschardet": "^3.1.4",
		"lang-map": "^0.4.0",
		"nanoid": "^5.1.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-easy-crop": "^5.5.6",
		"react-i18next": "^16.5.4",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.0.1",
		"tree-sitter-bash": "0.25.0",
		"web-tree-sitter": "0.25.10",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@tanstack/router-plugin": "^1.120.0",
		"@types/bun": "^1.2.0",
		"@types/dagre": "^0.7.53",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.4.0",
		"better-sqlite3": "^12.6.2",
		"drizzle-kit": "^0.31.0",
		"postcss": "^8.5.0",
		"postcss-preset-mantine": "^1.17.0",
		"postcss-simple-vars": "^7.0.0",
		"typescript": "^5.9.3",
		"vite": "^6.3.0",
		"vite-plugin-pwa": "^1.2.0"
	}
}
