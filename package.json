{
	"name": "narrafork",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bun run db:migrate; bun run --hot server/index.ts",
		"dev:frontend": "bunx vite --config frontend/vite.config.ts",
		"dev:all": "bun run db:migrate; bun run --hot server/index.ts & bunx vite --config frontend/vite.config.ts & wait",
		"dev:cold": "bun run db:migrate; bun run server/index.ts & bunx vite --config frontend/vite.config.ts & wait",
		"build": "bunx vite build --config frontend/vite.config.ts",
		"start": "bun run db:migrate && bun server/index.ts",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bun server/db/migrate.ts",
		"check": "bunx @biomejs/biome check .",
		"format": "bunx @biomejs/biome check --write .",
		"approve": "bun server/scripts/approve-all.ts",
		"test": "bun test",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.39",
		"@dagrejs/dagre": "^2.0.4",
		"@mantine/core": "^7.17.0",
		"@mantine/hooks": "^7.17.0",
		"@mantine/notifications": "^7.17.8",
		"@modelcontextprotocol/sdk": "^1.26.0",
		"@tabler/icons-react": "^3.36.1",
		"@tanstack/react-query": "^5.75.0",
		"@tanstack/react-router": "^1.120.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"@xyflow/react": "^12.10.0",
		"diff": "^8.0.3",
		"drizzle-orm": "^0.44.0",
		"hono": "^4.7.0",
		"i18next": "^25.8.6",
		"i18next-browser-languagedetector": "^8.2.1",
		"nanoid": "^5.1.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^16.5.4",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@tanstack/router-plugin": "^1.120.0",
		"@types/bun": "^1.2.0",
		"@types/dagre": "^0.7.53",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.4.0",
		"better-sqlite3": "^12.6.2",
		"drizzle-kit": "^0.31.0",
		"postcss": "^8.5.0",
		"postcss-preset-mantine": "^1.17.0",
		"postcss-simple-vars": "^7.0.0",
		"vite": "^6.3.0",
		"vite-plugin-pwa": "^1.2.0"
	}
}
