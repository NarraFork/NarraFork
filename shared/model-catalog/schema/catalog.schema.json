{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:narrafork:model-metadata",
	"$comment": "Identity contract only. Metadata is the open raw source map validated by validateRawMetadata (card.ts): missing key inherits; null is explicit unknown; false, [] and decimal 0 are real values. Arrays replace, objects merge by leaf. Priority: binding local > variant local > model local > discovered > preset variant > preset model > defaults. Identity: explicit binding/query, then scope, exact, alias, declared suffix, longest prefix; ties reject. Weak-match field groups restrict inherited model/variant layers; prefix prices require an explicit referencePricing group.",
	"$defs": {
		"MetadataSource": {
			"type": "object",
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1
				},
				"url": {
					"type": "string",
					"format": "uri"
				},
				"fields": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				},
				"verifiedAt": {
					"type": "string",
					"format": "date-time"
				}
			},
			"additionalProperties": false,
			"required": ["label"]
		},
		"MatchRules": {
			"type": "object",
			"properties": {
				"ids": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				},
				"aliases": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				},
				"prefixes": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				},
				"volatileSuffixes": {
					"type": "boolean"
				},
				"fields": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				}
			},
			"additionalProperties": false
		},
		"RawModel": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"vendor": {
					"type": "string",
					"minLength": 1
				},
				"family": {
					"type": "string",
					"minLength": 1
				},
				"notes": {
					"type": "string",
					"minLength": 1
				},
				"matches": {
					"$ref": "#/$defs/MatchRules"
				},
				"metadata": {
					"type": "object"
				},
				"status": {
					"enum": ["verified", "unverified", "legacy-unverified", "deprecated"]
				},
				"sources": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/MetadataSource"
					}
				}
			},
			"additionalProperties": false,
			"required": ["id", "metadata"]
		},
		"RawVariant": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"vendor": {
					"type": "string",
					"minLength": 1
				},
				"family": {
					"type": "string",
					"minLength": 1
				},
				"notes": {
					"type": "string",
					"minLength": 1
				},
				"matches": {
					"$ref": "#/$defs/MatchRules"
				},
				"metadata": {
					"type": "object"
				},
				"status": {
					"enum": ["verified", "unverified", "legacy-unverified", "deprecated"]
				},
				"sources": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/MetadataSource"
					}
				},
				"modelId": {
					"type": "string",
					"minLength": 1
				},
				"providerKey": {
					"type": "string",
					"minLength": 1
				},
				"upstreamModelIds": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				}
			},
			"additionalProperties": false,
			"required": ["id", "modelId", "providerKey", "upstreamModelIds", "metadata"]
		},
		"RawCatalog": {
			"type": "object",
			"properties": {
				"schemaVersion": {
					"enum": [2]
				},
				"catalogVersion": {
					"type": "string",
					"minLength": 1
				},
				"sourceVersion": {
					"type": "string",
					"minLength": 1
				},
				"publishedAt": {
					"type": "string",
					"format": "date-time"
				},
				"models": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/RawModel"
					}
				},
				"variants": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/RawVariant"
					}
				}
			},
			"additionalProperties": false,
			"required": [
				"schemaVersion",
				"catalogVersion",
				"sourceVersion",
				"publishedAt",
				"models",
				"variants"
			]
		}
	}
}
