					"uniqueItems": true
				},
				"hiddenVariantIds": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				}
			},
			"additionalProperties": false,
			"required": ["revision"]
		},
