				"reset": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"uniqueItems": true
				}
			},
			"additionalProperties": false
		},
		"CatalogUpdateStatus": {
			"type": "object",
			"properties": {
				"activeVersion": {
					"type": "string",
					"minLength": 1
				},
				"bundledVersion": {
					"type": "string",
					"minLength": 1
				},
				"lastCheckedAt": {
					"type": "string",
					"format": "date-time"
				},
				"pendingVersion": {
					"type": "string",
					"minLength": 1
				},
				"lastError": {
					"type": "string",
					"minLength": 1
				},
				"autoApply": {
