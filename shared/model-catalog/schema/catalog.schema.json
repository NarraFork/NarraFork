		"ModelCatalogMutation": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"baseRevision": {
							"type": "integer",
							"minimum": 0
						},
						"action": {
							"enum": ["upsert-model"]
						},
						"model": {
							"$ref": "#/$defs/ModelDefinition"
						}
					},
					"additionalProperties": false,
					"required": ["baseRevision", "action", "model"]
				},
				{
					"type": "object",
					"properties": {
						"baseRevision": {
							"type": "integer",
							"minimum": 0
