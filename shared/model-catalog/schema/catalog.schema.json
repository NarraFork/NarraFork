					"minLength": 1
				},
				"providerKey": {
					"type": "string",
					"minLength": 1
				},
				"providerId": {
					"type": "string",
					"minLength": 1
				},
				"channelId": {
					"type": "string",
					"minLength": 1
				},
				"modelId": {
					"type": "string",
					"minLength": 1
				},
				"variantId": {
					"type": "string",
					"minLength": 1
				}
			},
			"additionalProperties": false,
			"required": ["upstreamModelId"]
		},
		"FieldSource": {
			"type": "object",
			"properties": {
				"layer": {
					"enum": [
						"default",
						"preset-model",
						"preset-variant",
						"discovered",
						"local-model",
						"local-variant",
						"local-binding"
					]
				},
				"id": {
					"type": "string",
					"minLength": 1
				},
				"catalogVersion": {
					"type": "string",
					"minLength": 1
				},
				"explicit": {
					"type": "boolean"
				},
				"legacy": {
					"type": "boolean"
				}
			},
			"additionalProperties": false,
			"required": ["layer"]
		},
		"ResolvedModelMetadata": {
			"type": "object",
			"properties": {
				"schemaVersion": {
					"enum": [1]
				},
				"catalogVersion": {
					"type": "string",
					"minLength": 1
				},
				"localRevision": {
					"type": "integer",
					"minimum": 0
				},
				"modelId": {
					"type": "string",
					"minLength": 1
				},
				"variantId": {
					"type": "string",
					"minLength": 1
				},
				"bindingId": {
					"type": "string",
					"minLength": 1
				},
				"matchedVia": {
					"enum": ["binding", "exact", "alias", "suffix", "prefix", "none"]
				},
				"metadata": {
					"$ref": "#/$defs/ModelMetadata"
				},
				"provenance": {
					"type": "object",
					"additionalProperties": {
						"$ref": "#/$defs/FieldSource"
					}
				}
			},
			"additionalProperties": false,
			"required": [
				"schemaVersion",
				"catalogVersion",
				"localRevision",
				"matchedVia",
				"metadata",
				"provenance"
			]
		},
		"ResolveModelMetadataInput": {
			"type": "object",
			"properties": {
				"catalog": {
					"$ref": "#/$defs/CatalogDocument"
				},
				"query": {
					"$ref": "#/$defs/ModelQuery"
				},
				"local": {
					"$ref": "#/$defs/LocalCatalogState"
				},
				"discovered": {
					"$ref": "#/$defs/ModelMetadata"
				},
				"defaults": {
					"$ref": "#/$defs/ModelMetadata"
				}
			},
			"additionalProperties": false,
			"required": ["catalog", "query"]
		},
