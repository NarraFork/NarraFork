node_modules
dist/
# Required bundled model metadata, imported directly by the runtime.
!shared/model-catalog/dist/
shared/model-catalog/dist/*
!shared/model-catalog/dist/catalog.json
drizzle/
# NOTE: `drizzle-postgres/` is deliberately NOT ignored. The generated PG migration and its
# meta/ snapshot are tracked so the PostgreSQL test suite runs in a fresh clone without a
# generation step, matching the `!**/drizzle-postgres/**` entries in biome.json. The rule
# above is scoped to the SQLite `drizzle/` directory only; do not widen it to a prefix glob.

frontend/routeTree.gen.ts
server/generated/
*.db
*.db-journal
*.db-wal
*.db-shm
.worktrees/
.tanstack/

# Virtual-list layout calibration harness artifacts (dev-only)
vlist-harness-calibration.json
vlist-harness-calibration.png

# Packaged copies of examples/plugins produced by ShareFile (sources are tracked)
dist-share-*.zip

analyze/
analyze2/
.perf-analysis/
.narrafork/
.idea/

*.heapsnapshot
script/
scripts/*
!scripts/lib/
scripts/lib/*
!scripts/lib/latest-yml.ts
!scripts/lib/release-git.ts
# Imported by scripts/release.ts and tests/scripts/stable-baseline-patch*.test.ts, so it has
# to be in the repo or both the release script and `bun test` break in a fresh clone.
!scripts/lib/stable-baseline-patch.ts
# The remote executor release pipeline: the script is the only way to publish the
# executor, and its manifest builder is imported by scripts/lib/__tests__ and by
# tests/executor-bootstrap-e2e.test.ts, so both must be in the repo.
!scripts/release-executor.ts
# Native Windows ARM64 helper acquisition/cross-build must survive a fresh clone.
!scripts/prepare-windows-arm64-helpers.ts
!scripts/prepare-ripgrep-helpers.ts
!scripts/build-zstd-static.sh
!scripts/lib/helper-assets.ts
!scripts/lib/zstd-windows-arm64.ts
!scripts/lib/executor-manifest.ts
!scripts/lib/__tests__/
scripts/lib/__tests__/*
# Required by the cross-platform build and its post-processing workers.
!scripts/post-process-worker.ts
!scripts/lib/binary-metadata.ts
!scripts/lib/__tests__/binary-metadata.test.ts
!scripts/lib/__tests__/latest-yml.test.ts
!scripts/lib/__tests__/executor-manifest.test.ts
!scripts/lib/__tests__/helper-assets.test.ts
# The PostgreSQL schema generation chain. `server/db/postgres-schema.ts` is tracked and
# carries a "Generated by scripts/generate-postgres-schema.ts" header, so without the
# generator the only way to regenerate it is gone. The parity checker imports the
# generator, and both are imported by scripts/lib/__tests__, so `bun test` in a fresh
# clone fails on a missing module rather than on anything explaining why.
!scripts/generate-postgres-schema.ts
!scripts/check-postgres-schema-parity.ts
!scripts/finalize-postgres-seq-counter-migration.ts
# Canonical SQLite schema generation must be reproducible in fresh clones.
!scripts/generate-sqlite-migrations.ts
!scripts/finalize-sqlite-resource-migration.ts
!scripts/lib/__tests__/finalize-sqlite-resource-migration.test.ts
!scripts/lib/__tests__/generate-sqlite-migrations.test.ts
!scripts/lib/sqlite-generation-lock.ts
!scripts/lib/__tests__/sqlite-generation-lock.test.ts
!scripts/lib/__tests__/generate-postgres-schema.test.ts
!scripts/lib/__tests__/check-postgres-schema-parity.test.ts
!scripts/lib/__tests__/finalize-postgres-seq-counter-migration.test.ts
# Per-file isolated runner for the dual-database regression baseline; imported by
# tests/scripts/test-database-regression.test.ts. Its `artifacts/` reports are separate.
!scripts/test-database-regression.ts
!scripts/validate-plugin-release.ts
# Imported by tests/scripts/build-plugin.test.ts, so it has to be in the repo or
# `bun test` fails on a missing module in a fresh clone.
!scripts/build-plugin.ts
# Standalone shared-runtime UI build pilot and its integration test entry.
!scripts/build-plugin-ui.ts
# The only way to produce the VS Code extension's .vsix. `scripts/*` above is a
# blanket ignore, so without this line the script would silently be absent from a
# fresh clone and `bun run package` inside vscode-extension/ would fail on a missing
# module rather than on anything explaining why.
!scripts/package-vscode-extension.ts
# Reproducible tool-body follow regression harness; reports remain under .narrafork/.
!scripts/smoke-tool-content-follow.ts
!scripts/smoke-tool-content-follow-fixture.tsx
# Reproducible long Write streaming fixture; before/after reports remain ignored.
!scripts/smoke-write-stream.ts
!scripts/smoke-write-stream-fixture.tsx
!scripts/smoke-write-stream-data.ts
!scripts/smoke-write-stream-data.test.ts
!scripts/smoke-vlist-text-preview.ts
!scripts/smoke-vlist-text-preview-fixture.tsx
# Monaco regression sources are required in fresh clones; generated reports stay ignored.
!scripts/smoke-monaco-large-file*.ts
!scripts/smoke-monaco-large-file*.tsx
!scripts/smoke-file-navigation.ts
!scripts/smoke-file-navigation-fixture.tsx
!scripts/smoke-editor-real-io-fixture.tsx
.tmp-narrafork-home.*
.release.local.json
mitm-dump/
*-dump.json
package-lock.json
IMPROVEMENT-PLAN.md
*.log

# Dynamic Spec runtime state (per-narrator task queue / planning notes)
spec/
spec:/

# Dual-database regression reports written by scripts/test-database-regression.ts
# (ARTIFACT_ROOT). Per-run junit XML, results.json, rerun.txt and logs are reproducible
# output, not source. Scoped to this subdirectory rather than all of `artifacts/` because
# `artifacts/` also holds hand-captured screenshots that are the user's own files.
artifacts/dual-database-regression/
artifacts/git-expand-review/
artifacts/*.png

# VS Code extension: build output and packaged artifacts. The SOURCES are tracked;
# only the compiled `out/` and the .vsix are derived. `node_modules` is separate from
# the repo root's because the extension runs on Node with its own toolchain.
vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/*.vsix
# Scratch fixtures written by tests/vscode-extension/discovery.test.ts. Kept inside the
# test directory (rather than /tmp) so the path stays within the working tree; each run
# deletes its own, this covers an interrupted run.
tests/vscode-extension/.tmp-settings-*.json

# bun build cache
.*.bun-build
