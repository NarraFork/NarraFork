{
	"schemaVersion": 1,
	"pluginId": "com.narrafork.cline-external",
	"version": "0.1.4",
	"displayName": "Cline (External)",
	"description": "Cline provider running as an out-of-process plugin, alongside the built-in adapter.",
	"publisher": {
		"id": "com.narrafork",
		"name": "NarraFork"
	},
	"license": "Apache-2.0",
	"engine": {
		"runtime": "bun",
		"runtimeVersion": ">=1.2 <2",
		"hostApi": ">=1.0 <2",
		"rpc": "narrafork.rpc/1",
		"features": ["host_api.notifications", "rpc.cancel", "host_api.requests"],
		"os": ["linux", "darwin", "win32"],
		"arch": ["x64", "arm64"],
		"runner": "local-process"
	},
	"server": {
		"entry": "server/index.js",
		"transport": "stdio",
		"protocol": "narrafork.rpc/1",
		"args": [],
		"workingDirectory": "package",
		"startupTimeoutMs": 15000,
		"activationTimeoutMs": 30000
	},
	"activationEvents": ["onProvider:cline", "onView:cline-external-settings"],
	"contributes": {
		"providers": [
			{
				"id": "cline",
				"title": "Cline (External)",
				"description": "Models from the Cline API gateway, which proxies OpenRouter.",
				"providerPrefix": "cline-ext",
				"defaultModelId": "anthropic/claude-sonnet-4.6",
				"modelDiscovery": true,
				"sessionMode": "stateless",
				"maxConcurrency": 2,
				"capabilities": {
					"validateConfig": true,
					"listModels": true,
					"chat": true,
					"generate": true,
					"reasoningContinuation": false,
					"inputImages": true
				},
				"limits": {
					"maxConcurrentChat": 2,
					"maxConcurrentGenerate": 1,
					"maxConfigBytes": 131072,
					"maxModelPageSize": 50
				},
				"configSchema": {
					"credentials": {
						"type": "string",
						"title": "Credentials",
						"description": "The Cline OAuth session as one JSON object. Managed from this provider's own settings view; not meant to be edited by hand.",
						"writeOnly": true,
						"x-narrafork-secret": true
					},
					"enabledModels": {
						"type": "string",
						"title": "Enabled models",
						"description": "JSON array of model ids selected from the OpenRouter pool. Only these are offered to the agent. Edited from this provider's own settings view.",
						"writeOnly": true,
						"x-narrafork-secret": true
					},
					"baseUrl": {
						"type": "string",
						"title": "API base URL",
						"description": "Cline API gateway base URL.",
						"default": "https://api.cline.bot/api/v1",
						"maxLength": 2048
					}
				}
			}
		],
		"searchProviders": [],
		"tools": [],
		"commands": [
			{
				"id": "status",
				"title": "Cline account status",
				"description": "Sign-in state, enabled model count and whether browser sign-in is usable.",
				"handler": "server"
			},
			{
				"id": "auth.browser",
				"title": "Start browser sign-in",
				"description": "Opens a local callback listener and returns the Cline authorization URL.",
				"handler": "server"
			},
			{
				"id": "auth.cancel",
				"title": "Cancel a pending sign-in",
				"handler": "server"
			},
			{
				"id": "auth.callback",
				"title": "Import a pasted callback URL",
				"description": "For deployments where the browser cannot reach a local callback listener.",
				"handler": "server"
			},
			{
				"id": "auth.logout",
				"title": "Sign out",
				"description": "Clears the stored credentials. Enabled model selection is kept.",
				"handler": "server"
			},
			{
				"id": "balance",
				"title": "Fetch account balance",
				"handler": "server"
			},
			{
				"id": "recommended-models",
				"title": "Recommended and free models",
				"handler": "server"
			},
			{
				"id": "models.refresh",
				"title": "Refresh the OpenRouter model pool",
				"handler": "server"
			},
			{
				"id": "models.search",
				"title": "Search the model pool",
				"handler": "server"
			},
			{
				"id": "config.setEnabledModels",
				"title": "Set enabled models",
				"description": "Replaces the list of models offered to the agent.",
				"handler": "server"
			}
		],
		"events": [],
		"views": [
			{
				"id": "cline-external-settings",
				"title": "Cline account",
				"entry": "ui/provider-settings.iife.js",
				"surfaces": ["provider-settings"],
				"scope": "global",
				"instance": "singleton",
				"providerId": "cline",
				"runtime": "host-react"
			}
		]
	},
	"ui": {
		"entry": "ui/provider-settings.iife.js"
	},
	"permissions": {
		"host": [
			"provider.register",
			"provider.use",
			"ui.panel",
			"config.read_self",
			"secret.use_self"
		],
		"network": {
			"mode": "allowlist",
			"allow": ["https://api.cline.bot", "https://openrouter.ai"],
			"domains": ["api.cline.bot", "openrouter.ai"],
			"ports": [443],
			"protocols": ["https"],
			"followRedirects": false,
			"maxConnections": 8,
			"inbound": {
				"reason": "OAuth sign-in needs a loopback listener to receive the browser callback. Opened only while a sign-in is pending, closed on completion, timeout, deactivate and shutdown. See docs/plugin-system/07-security-and-sandbox.md 6.2.",
				"loopbackPorts": [19876]
			}
		},
		"filesystem": {
			"package": "readOnly",
			"pluginData": "readWrite",
			"workspace": "none"
		},
		"process": {
			"spawn": "none"
		}
	}
}
